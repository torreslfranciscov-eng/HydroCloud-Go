@model StationList
@{ ViewData["Title"]="Estaciones"; }
<div class="titlebar"><div><p class="eyebrow">RED HIDROMETEOROLÓGICA</p><h1>Estaciones</h1><p>Administra la ubicación, clasificación y disponibilidad de tu red.</p></div><a class="button primary" asp-action="Create">+ Nueva estación</a></div>
<section class="metrics"><article class="card"><span>Estaciones activas en la red</span><strong>@Model.ActiveCount.ToString("N0")</strong></article><article class="card"><span>Resultados de la búsqueda</span><strong>@Model.Total.ToString("N0")</strong></article><article class="card"><span>Consulta de mediciones</span><strong class="small">Siguiente etapa</strong></article></section>
<section class="card"><form method="get" class="filters"><label>Buscar nombre o clave<input name="search" value="@Model.Search" maxlength="255" placeholder="Ej. Grijalva o CFE0000002"/></label><label>Estado<select name="state"><option value="all" selected="@(Model.StateFilter=="all")">Todas</option><option value="active" selected="@(Model.StateFilter=="active")">Activas</option><option value="inactive" selected="@(Model.StateFilter=="inactive")">Inactivas</option></select></label><button class="primary">Buscar</button><a asp-action="Index">Limpiar</a></form>
<div class="table-scroll"><table><thead><tr><th>Estación</th><th>Clave</th><th>Ubicación</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var s in Model.Items) { <tr><td><strong>@s.Name</strong><small>@s.Tag</small></td><td>@s.Code</td><td>@(s.Latitude?.ToString("F5",System.Globalization.CultureInfo.InvariantCulture)??"—"), @(s.Longitude?.ToString("F5",System.Globalization.CultureInfo.InvariantCulture)??"—")</td><td><span class="badge @(s.Active?"active":"inactive")">@(s.Active?"Activa":"Inactiva")</span></td><td class="actions"><a asp-controller="Equipment" asp-action="Index" asp-route-stationId="@s.Id">Ficha técnica</a><a asp-action="Edit" asp-route-id="@s.Id">Editar</a>@if(s.Active) { <a class="danger" asp-action="Delete" asp-route-id="@s.Id">Dar de baja</a> }</td></tr> }
@if(Model.Items.Count==0) { <tr><td colspan="5" class="empty">No hay estaciones que coincidan con la búsqueda.</td></tr> }
</tbody></table></div><div class="pagination"><span>Página @Model.Page de @Model.Pages · 25 por página</span><div>@if(Model.Page>1) { <a asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-state="@Model.StateFilter">← Anterior</a> } @if(Model.Page<Model.Pages) { <a asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-state="@Model.StateFilter">Siguiente →</a> }</div></div></section>
