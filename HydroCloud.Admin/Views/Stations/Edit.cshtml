@model StationForm
@{ var create=string.IsNullOrEmpty(Model.Station.Id); ViewData["Title"]=create?"Nueva estación":"Editar estación"; }
<a asp-action="Index">← Volver a estaciones</a><div class="titlebar"><div><p class="eyebrow">CATÁLOGO HYDROCLOUD</p><h1>@ViewData["Title"]</h1><p>Los campos de clave y nombre son obligatorios.</p></div>@if(!create) { <a class="button primary" asp-controller="Equipment" asp-action="Index" asp-route-stationId="@Model.Station.Id">Comunicaciones, sensores e inventario →</a> }</div>
<form method="post" asp-action="@(create?"Create":"Edit")" class="card editor">
<input asp-for="Station.Id" type="hidden"/><input asp-for="Token" type="hidden"/><div asp-validation-summary="All" class="validation" role="alert"></div>
<h2>Identificación</h2><div class="grid"><label asp-for="Station.Code">Clave de estación<input asp-for="Station.Code" maxlength="255" required/></label><label asp-for="Station.Name">Nombre<input asp-for="Station.Name" maxlength="255" required/></label><label asp-for="Station.Tag">Etiqueta<input asp-for="Station.Tag" maxlength="50"/></label></div>
<h2>Ubicación y clasificación</h2><div class="grid"><label asp-for="Station.Latitude">Latitud<input asp-for="Station.Latitude" type="number" step="any" min="-90" max="90"/></label><label asp-for="Station.Longitude">Longitud<input asp-for="Station.Longitude" type="number" step="any" min="-180" max="180"/></label>
@foreach(var (key,label,value) in new[] {("Basin","Cuenca",Model.Station.Basin),("SubBasin","Subcuenca",Model.Station.SubBasin),("State","Entidad federativa",Model.Station.State?.ToString()),("Municipality","Municipio",Model.Station.Municipality?.ToString()),("Organization","Organismo",Model.Station.Organization?.ToString()),("Status","Estatus de bitácora",Model.Station.Status?.ToString()) }) {
<label>@label<select name="Station.@key" id="Station_@key"><option value="">Sin asignar</option>@foreach(var item in Model.Catalogs[key]) { <option value="@item.Id" data-parent="@item.Parent" selected="@(item.Id==value)">@item.Name</option> }</select></label>
}
</div><h2>Disponibilidad y canales</h2><div class="checks"><label><input asp-for="Station.Active"/> Activa</label><label><input asp-for="Station.Visible"/> Visible</label><label><input asp-for="Station.Goes"/> GOES</label><label><input asp-for="Station.Gprs"/> GPRS</label><label><input asp-for="Station.Radio"/> Radio</label><label><input asp-for="Station.IsDam"/> Es presa</label></div><p class="hint">Estos indicadores no sustituyen la configuración del canal. Administra DCP, transmisión y sensores desde la ficha de comunicaciones e inventario.</p>
<label asp-for="Station.Comment">Comentario<textarea asp-for="Station.Comment" rows="4" maxlength="10000"></textarea></label><div class="form-actions"><button class="primary">Guardar estación</button><a asp-action="Index">Cancelar</a></div></form>
