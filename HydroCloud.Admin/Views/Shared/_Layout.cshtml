<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>@ViewData["Title"] · HydroCloud Data Studio</title>
    <link rel="icon" type="image/jpeg" href="~/favicon.jpg"/>
    <link rel="stylesheet" href="~/hydro-cyber.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/vendor/leaflet/leaflet.css"/>
    <link rel="stylesheet" href="~/explore.css" asp-append-version="true"/>
    <script src="~/vendor/chart.umd.min.js"></script>
</head>
<body class="@(ViewData["CompactExplore"] as bool? == true ? "compact-explore" : null)">
<header class="hydro-header">
    <div class="brand-container">
        <a asp-controller="Explore" asp-action="Index" style="display:flex;align-items:center;gap:12px;text-decoration:none">
            <img src="~/hydrocloud_logo.jpg" alt="HydroCloud Studio" class="brand-logo-img"/>
            <div>
                <span class="brand-title">HydroCloud <span class="brand-product">Data Studio</span></span>
                <span class="brand-subtitle">Análisis hidrometeorológico</span>
            </div>
        </a>
        <div class="system-live-pill" id="system-live-pill" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false" title="Telemetría en tiempo real del colector satelital (Click para ver detalles)">
            <span class="live-pulse-radar">
                <span class="radar-core"></span>
                <span class="radar-wave"></span>
            </span>
            <span class="live-status-label" id="live-header-status-label">EN VIVO</span>
            <span class="live-dot-sep">·</span>
            <span class="live-tx-detail" id="global-live-last-tx">Sincronizando…</span>

            <!-- Tooltip / Popover flotante deluxe -->
            <div class="live-telemetry-popover" id="live-telemetry-popover" role="tooltip">
                <div class="popover-head">
                    <span class="pulse-em">📡</span>
                    <div style="min-width:0;">
                        <div class="popover-title">COLECTOR SATELITAL GOES</div>
                        <div class="popover-subtitle">NOAA LRGS · TimescaleDB Cloud</div>
                    </div>
                    <span class="popover-status-badge" id="popover-badge-status">ACTIVO</span>
                </div>
                <div class="popover-metrics">
                    <div class="popover-metric-row">
                        <span class="lbl">Daemon colector:</span>
                        <span class="val ok" id="pop-daemon-val">● En ejecución (24/7)</span>
                    </div>
                    <div class="popover-metric-row">
                        <span class="lbl">Servidores LRGS:</span>
                        <span class="val mono">eddn1 · eddn2 · eddn3</span>
                    </div>
                    <div class="popover-metric-row">
                        <span class="lbl">Última TX recibida:</span>
                        <span class="val highlight" id="pop-last-tx-val">—</span>
                    </div>
                    <div class="popover-metric-row">
                        <span class="lbl">DCP satelital:</span>
                        <span class="val mono" id="pop-last-dcp-val">—</span>
                    </div>
                    <div class="popover-metric-row">
                        <span class="lbl">Sincronización mapa:</span>
                        <span class="val accent">Auto-refresco cada 45s</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="nav-cyber-links">
        <a asp-controller="Explore" asp-action="Index" class="nav-cyber-link active">Mapa y consultas</a>
        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="Stations" asp-action="Index" class="nav-cyber-link">Estaciones</a>
            <a asp-controller="Explore" asp-action="Visitors" class="nav-cyber-link">Auditoría</a>
        }
        <div id="layout-auth-container" style="display:inline-flex;align-items:center;gap:10px;">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span style="color:var(--text-muted);font-size:0.85rem">👤 @User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                <button type="submit" class="btn-cyber-secondary" style="padding:4px 12px;font-size:0.8rem">Salir</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="header-login">Acceso histórico</a>
        }
        </div>
    </div>
</header>

<main class="hydro-main-wrap">
    @if (TempData["Success"] is string success)
    {
        <div style="background:rgba(0,255,157,0.15);border:1px solid var(--cyber-green);color:var(--cyber-green);padding:12px 18px;border-radius:8px;margin-bottom:20px">
            ✔ @success
        </div>
    }
    @RenderBody()
</main>

<footer style="text-align:center;padding:24px;border-top:1px solid var(--glass-border);color:var(--text-muted);font-size:0.8rem">
    HydroCloud Data Studio &middot; Plataforma Independiente .NET 8 &middot; Estándares Hidrológicos WMO / OGC WaterML2
</footer>

<script src="~/site.js" asp-append-version="true" defer></script>
</body>
</html>
