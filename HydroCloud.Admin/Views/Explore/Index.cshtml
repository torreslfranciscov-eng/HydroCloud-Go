    <!-- MODAL 5: GESTIÓN DE MIS ESTACIONES GOES -->
    <dialog id="user-stations-dialog" class="query-dialog" aria-labelledby="user-stations-title" style="max-width:760px;height:auto;max-height:94vh;">
      <div class="query-dialog-shell">
        <header class="query-dialog-header">
            <div>
                <span>Telemetría Satelital SatGOES NOAA</span>
                <h2 id="user-stations-title">📡 Mis Estaciones GOES</h2>
            </div>
            <button id="close-user-stations-dialog" type="button" aria-label="Cerrar modal de estaciones">×</button>
        </header>

        <!-- Barra de Estado / Cuota del Plan -->
        <div style="background:#f0f9ff;border-bottom:1px solid #bae6fd;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
            <div style="display:flex;align-items:center;gap:8px;font-size:0.75rem;color:#0369a1;">
                <span>Plan: <strong id="station-dialog-plan-name">GRATIS</strong></span>
                <span>•</span>
                <span id="station-quota-text"><strong>0 de 1</strong> estaciones utilizadas</span>
            </div>
            <div style="display:flex;gap:6px;">
                <button id="btn-tab-list-stations" type="button" class="btn-cyber-primary" style="height:26px;font-size:0.68rem;padding:0 10px;">
                    📋 Mis Estaciones (<span id="user-stations-tab-count">0</span>)
                </button>
                <button id="btn-tab-new-station" type="button" class="btn-cyber-gold" style="height:26px;font-size:0.68rem;padding:0 10px;">
                    ➕ Dar de Alta Estación
                </button>
            </div>
        </div>

        <div class="query-dialog-body" style="padding:16px;max-height:72vh;overflow-y:auto;">
            <!-- VISTA 1: LISTADO DE MIS ESTACIONES -->
            <div id="view-stations-list" style="display:block;">
                <div id="user-stations-empty" style="display:none;text-align:center;padding:32px 14px;background:#f8fafc;border:2px dashed #cbd5e1;border-radius:10px;">
                    <div style="font-size:2.2rem;margin-bottom:8px;">🛰️</div>
                    <h3 style="margin:0 0 6px;color:#1e293b;font-size:0.95rem;">Aún no tienes estaciones registradas</h3>
                    <p style="margin:0 0 14px;color:#64748b;font-size:0.75rem;max-width:440px;margin-inline:auto;">
                        Puedes dar de alta estaciones GOES para que HydroCloud descargue vía satélite, decodifique y grafique en tiempo real sus sensores.
                    </p>
                    <button id="btn-empty-add-station" type="button" class="btn-cyber-gold" style="padding:8px 16px;font-size:0.75rem;">
                        ✨ Dar de alta mi primera estación
                    </button>
                </div>

                <div id="user-stations-cards" style="display:grid;grid-template-columns:1fr;gap:12px;"></div>
            </div>

            <!-- VISTA 2: FORMULARIO DE ALTA / EDICIÓN -->
            <div id="view-stations-form" style="display:none;">
                <form id="form-user-station" onsubmit="return false;">
                    <input type="hidden" id="form-station-id" value="" />

                    <!-- Bloque 1: Datos Generales -->
                    <div style="border:1px solid #e2e8f0;border-radius:8px;padding:12px;margin-bottom:12px;background:#fafafa;">
                        <h4 style="margin:0 0 10px;font-size:0.78rem;color:#0f3844;text-transform:uppercase;letter-spacing:0.5px;">
                            1. Datos Generales de la Estación
                        </h4>
                        <div style="display:grid;grid-template-columns:1fr 2fr;gap:10px;margin-bottom:10px;">
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#475569;margin-bottom:3px;">Clave / ID Asignado *</label>
                                <input id="form-station-code" type="text" placeholder="Ej. MIEST01" style="width:100%;height:32px;font-size:0.75rem;font-family:var(--font-code);text-transform:uppercase;border:1px solid #cbd5e1;border-radius:5px;padding:0 8px;" required />
                            </div>
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#475569;margin-bottom:3px;">Nombre de la Estación *</label>
                                <input id="form-station-name" type="text" placeholder="Ej. Rancho San Carlos" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #cbd5e1;border-radius:5px;padding:0 8px;" required />
                            </div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;align-items:flex-end;">
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#475569;margin-bottom:3px;">Latitud (decimal) *</label>
                                <input id="form-station-lat" type="number" step="any" placeholder="19.4326" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #cbd5e1;border-radius:5px;padding:0 8px;" required />
                            </div>
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#475569;margin-bottom:3px;">Longitud (decimal) *</label>
                                <input id="form-station-lon" type="number" step="any" placeholder="-99.1332" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #cbd5e1;border-radius:5px;padding:0 8px;" required />
                            </div>
                            <div>
                                <button id="btn-station-use-map-center" type="button" class="btn-cyber-secondary" style="width:100%;height:32px;font-size:0.68rem;justify-content:center;" title="Usar las coordenadas del centro del mapa">
                                    📍 Centro del Mapa
                                </button>
                            </div>
                        </div>
                        <div style="margin-top:10px;">
                            <label style="display:block;font-size:0.68rem;font-weight:700;color:#475569;margin-bottom:3px;">Cuenca Hidrológica (Opcional)</label>
                            <select id="form-station-cuenca" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #cbd5e1;border-radius:5px;padding:0 8px;">
                                <option value="">Sin cuenca asignada (o Cuenca privada)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Bloque 2: Parámetros Satelitales GOES -->
                    <div style="border:1px solid #bae6fd;border-radius:8px;padding:12px;margin-bottom:12px;background:#f0f9ff;">
                        <h4 style="margin:0 0 10px;font-size:0.78rem;color:#0369a1;text-transform:uppercase;letter-spacing:0.5px;">
                            2. Configuración Satelital GOES (NESDIS / NOAA)
                        </h4>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:10px;">
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#0369a1;margin-bottom:3px;">DCP ID (8 Hex) *</label>
                                <input id="form-station-dcpid" type="text" maxlength="8" placeholder="CE1A4B02" style="width:100%;height:32px;font-size:0.8rem;font-family:var(--font-code);text-transform:uppercase;border:1px solid #7dd3fc;border-radius:5px;padding:0 8px;font-weight:bold;color:#0369a1;" required />
                            </div>
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#0369a1;margin-bottom:3px;">Primera Transmisión (UTC) *</label>
                                <input id="form-station-primera" type="text" placeholder="00:15:00" style="width:100%;height:32px;font-size:0.75rem;font-family:var(--font-code);border:1px solid #7dd3fc;border-radius:5px;padding:0 8px;" required />
                            </div>
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#0369a1;margin-bottom:3px;">Intervalo de Transmisión</label>
                                <select id="form-station-intervalo" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #7dd3fc;border-radius:5px;padding:0 8px;">
                                    <option value="01:00:00" selected>Cada 1 hora (01:00:00)</option>
                                    <option value="00:30:00">Cada 30 minutos (00:30:00)</option>
                                    <option value="02:00:00">Cada 2 horas (02:00:00)</option>
                                    <option value="03:00:00">Cada 3 horas (03:00:00)</option>
                                </select>
                            </div>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1.5fr;gap:10px;">
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#0369a1;margin-bottom:3px;">Canal Primario</label>
                                <input id="form-station-canal" type="number" min="1" max="266" value="169" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #7dd3fc;border-radius:5px;padding:0 8px;" />
                            </div>
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#0369a1;margin-bottom:3px;">Satélite</label>
                                <select id="form-station-satelite" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #7dd3fc;border-radius:5px;padding:0 8px;">
                                    <option value="GOES-E" selected>GOES-East (75° W)</option>
                                    <option value="GOES-W">GOES-West (137° W)</option>
                                </select>
                            </div>
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#0369a1;margin-bottom:3px;">Velocidad</label>
                                <select id="form-station-baud" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #7dd3fc;border-radius:5px;padding:0 8px;">
                                    <option value="300" selected>300 baud</option>
                                    <option value="1200">1200 baud</option>
                                    <option value="100">100 baud</option>
                                </select>
                            </div>
                            <div>
                                <label style="display:block;font-size:0.68rem;font-weight:700;color:#0369a1;margin-bottom:3px;">Formato Decodificador</label>
                                <select id="form-station-decoder" style="width:100%;height:32px;font-size:0.75rem;border:1px solid #7dd3fc;border-radius:5px;padding:0 8px;">
                                    <option value="GS300" selected>GS300 (Estándar Sutron/OTT)</option>
                                    <option value="OTTBinario">OTTBinario (Binario comprimido)</option>
                                    <option value="SMN">SMN (Servicio Meteorológico Nal)</option>
                                    <option value="SMN_ver2">SMN ver2 (Nuevo protocolo)</option>
                                    <option value="VAISALA_Protocol_Text">VAISALA Protocol Text</option>
                                    <option value="CILA_Text">CILA Text</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 3: Sensores a Monitorear -->
                    <div style="border:1px solid #fed7aa;border-radius:8px;padding:12px;margin-bottom:14px;background:#fffbeb;">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                            <h4 style="margin:0;font-size:0.78rem;color:#92400e;text-transform:uppercase;letter-spacing:0.5px;">
                                3. Sensores a Decodificar
                            </h4>
                            <span style="font-size:0.68rem;color:#92400e;">Selecciona las variables que transmite tu estación</span>
                        </div>

                        <div id="sensor-presets-container" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                            <!-- Sensor 1: Precipitación -->
                            <label style="display:flex;align-items:flex-start;gap:8px;padding:8px;background:#fff;border:1px solid #fde68a;border-radius:6px;cursor:pointer;">
                                <input type="checkbox" id="chk-sensor-rain" checked style="margin-top:2px;" />
                                <div style="font-size:0.72rem;">
                                    <strong>🌧️ Precipitación / Lluvia</strong>
                                    <div style="color:#64748b;font-size:0.65rem;">Sensor 0017 • mm (0 - 300)</div>
                                </div>
                            </label>
                            <!-- Sensor 2: Nivel de agua -->
                            <label style="display:flex;align-items:flex-start;gap:8px;padding:8px;background:#fff;border:1px solid #fde68a;border-radius:6px;cursor:pointer;">
                                <input type="checkbox" id="chk-sensor-level" checked style="margin-top:2px;" />
                                <div style="font-size:0.72rem;">
                                    <strong>🌊 Nivel de agua</strong>
                                    <div style="color:#64748b;font-size:0.65rem;">Sensor 0018 • m (0 - 50)</div>
                                </div>
                            </label>
                            <!-- Sensor 3: Temperatura -->
                            <label style="display:flex;align-items:flex-start;gap:8px;padding:8px;background:#fff;border:1px solid #fde68a;border-radius:6px;cursor:pointer;">
                                <input type="checkbox" id="chk-sensor-temp" checked style="margin-top:2px;" />
                                <div style="font-size:0.72rem;">
                                    <strong>🌡️ Temperatura</strong>
                                    <div style="color:#64748b;font-size:0.65rem;">Sensor 0019 • °C (-20 - 60)</div>
                                </div>
                            </label>
                            <!-- Sensor 4: Voltaje batería -->
                            <label style="display:flex;align-items:flex-start;gap:8px;padding:8px;background:#fff;border:1px solid #fde68a;border-radius:6px;cursor:pointer;">
                                <input type="checkbox" id="chk-sensor-batt" checked style="margin-top:2px;" />
                                <div style="font-size:0.72rem;">
                                    <strong>🔋 Voltaje Batería</strong>
                                    <div style="color:#64748b;font-size:0.65rem;">Sensor 0020 • V (0 - 20)</div>
                                </div>
                            </label>
                            <!-- Sensor 5: Humedad relativa -->
                            <label style="display:flex;align-items:flex-start;gap:8px;padding:8px;background:#fff;border:1px solid #fde68a;border-radius:6px;cursor:pointer;">
                                <input type="checkbox" id="chk-sensor-humidity" style="margin-top:2px;" />
                                <div style="font-size:0.72rem;">
                                    <strong>💧 Humedad Relativa</strong>
                                    <div style="color:#64748b;font-size:0.65rem;">Sensor 0021 • % (0 - 100)</div>
                                </div>
                            </label>
                            <!-- Sensor 6: Presión atmosférica -->
                            <label style="display:flex;align-items:flex-start;gap:8px;padding:8px;background:#fff;border:1px solid #fde68a;border-radius:6px;cursor:pointer;">
                                <input type="checkbox" id="chk-sensor-pressure" style="margin-top:2px;" />
                                <div style="font-size:0.72rem;">
                                    <strong>🧭 Presión Atmosférica</strong>
                                    <div style="color:#64748b;font-size:0.65rem;">Sensor 0022 • hPa (500 - 1100)</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div id="station-form-error" style="display:none;padding:8px 12px;background:#fef2f2;border:1px solid #fca5a5;border-radius:6px;color:#b91c1c;font-size:0.72rem;font-weight:700;margin-bottom:12px;"></div>

                    <!-- Botones de Acción -->
                    <div style="display:flex;gap:10px;justify-content:flex-end;">
                        <button id="btn-cancel-station" type="button" class="btn-cyber-secondary" style="height:34px;padding:0 14px;font-size:0.75rem;">
                            Cancelar
                        </button>
                        <button id="btn-save-station" type="submit" class="btn-cyber-gold" style="height:34px;padding:0 18px;font-size:0.75rem;font-weight:750;">
                            💾 Guardar y Conectar Estación
                        </button>
                    </div>
                </form>
            </div>
        </div>
      </div>
    </dialog>

    <!-- MODAL 6: SUSCRIPCIÓN PAYPAL PRO ($100 MXN), ENTERPRISE ($200 MXN) Y TODO ILIMITADO ($500 MXN) -->
    <dialog id="paypal-modal-dialog" class="query-dialog paypal-modal-dialog" aria-labelledby="paypal-modal-title" style="max-width:760px;height:auto;max-height:94vh;">
      <div class="query-dialog-shell">
        <header class="query-dialog-header">
            <div>
                <span>Planes de Suscripción HydroCloud</span>
                <h2 id="paypal-modal-title">⭐ Planes & Suscripciones HydroCloud</h2>
            </div>
