@{
    ViewData["Title"] = "Centro de Comando Hidrometeorológico";
    ViewData["CompactExplore"] = true;
    var auth = User.Identity?.IsAuthenticated == true;
}

<div id="explorer" data-authenticated="@(auth ? "true" : "false")">

    <!-- SECCIÓN 1: MAPA GIS Y SALUD OPERATIVA -->
    <section class="cyber-card map-card">
        <!-- FILA 1: TÍTULO Y SEMÁFOROS DE SALUD OPERATIVA -->
        <div class="map-header-row">
            <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;min-width:0;">
                <h2 class="cyber-card-title">Red hidrometeorológica</h2>

                <div class="map-health-legend" aria-label="Disponibilidad de estaciones">
                    <span title="Última TX dentro del intervalo esperado"><i class="signal recent"></i>A tiempo <b id="count-recent">—</b></span>
                    <span title="Última TX excede el intervalo esperado"><i class="signal week"></i>Retrasada <b id="count-week">—</b></span>
                    <span title="Sin TX dentro del margen operativo"><i class="signal historical"></i>Fuera de línea <b id="count-historical">—</b></span>
                    <span title="DCP configurado sin historial de TX"><i class="signal empty"></i>Sin TX <b id="count-empty">—</b></span>
                    <span title="Sin DCP vinculado o estado no verificable"><i class="signal unknown"></i>Sin verificar <b id="count-unknown">—</b></span>
                    <span title="EsPresa=1 o nombre con la palabra PRESA"><span class="dam-key" aria-hidden="true"><span>≋</span></span> Presas <b id="count-dams">—</b></span>
                    <span title="Relaciones hidrológicas registradas en DB_ATLAS"><span class="upstream-key" aria-hidden="true"></span> Aguas arriba</span>
                </div>
            </div>

            <div id="saas-user-bar" class="saas-user-bar">
                <button id="btn-saas-auth-trigger" class="btn-cyber-secondary" type="button" style="height:28px;padding:0 12px;font-size:0.72rem;font-weight:750;white-space:nowrap;">
                    👤 Entrar / Registro Gratis
                </button>
            </div>
        </div>

        <!-- FILA 2: CONTROLES DE VISTA, FILTRO DE CUENCA Y ACCIONES -->
        <div class="map-commandbar">
            <div class="map-filter-control">
                <label for="map-filter">Vista</label>
                <select id="map-filter" class="cyber-select">
                    <option value="all" selected>Todas las estaciones</option>
                    <option value="user_stations">⭐ Mis Estaciones GOES</option>
                    <option value="dams">Presas (campo o nombre)</option>
                    <option value="recent">🟢 TX a tiempo</option>
                    <option value="week">🟡 TX retrasada</option>
                    <option value="historical">🔴 Fuera de línea</option>
                    <option value="empty">⚫ Sin historial de TX</option>
                </select>
            </div>

            <div class="map-filter-control cuenca-filter-control">
                <label for="cuenca-filter">Cuenca</label>
                <select id="cuenca-filter" class="cyber-select">
                    <option value="">Todas las cuencas (Catálogo completo)</option>
                </select>
            </div>

            <div class="map-cuenca-actions">
                <button id="btn-open-user-stations" class="btn-cyber-primary" type="button" title="Gestionar y dar de alta mis estaciones GOES" style="height:32px;padding:0 12px;font-size:0.75rem;font-weight:750;display:inline-flex;align-items:center;gap:6px;border-radius:6px;">
                    <span>📡</span> Mis Estaciones <span id="user-stations-badge-count" class="saas-badge" style="background:#0284c7;color:#fff;font-size:0.62rem;padding:1px 5px;display:none;">0/1</span>
                </button>
                <button id="btn-cuenca-lluvia" class="btn-cyber-cuenca" type="button" title="Analizar lluvia horaria y promedio">
                    🌧️ Lluvia en cuenca
                </button>
                <button id="btn-armar-grupo" class="btn-cyber-gold" type="button" title="Arma un grupo personalizado de estaciones">
                    ✨ ¡Armar mi cuenca o grupo!
                </button>
                <button id="btn-open-3d-globe" class="btn-cyber-deluxe" type="button" title="Constelación Satelital NOAA GOES & Red Terrestre en 3D (Three.js)">
                    🛰️ Órbita GOES 3D
                </button>
            </div>
        </div>

        <div class="map-viewport">
            <div id="station-map" aria-label="Mapa de disponibilidad espacial de estaciones, ciclones tropicales y sismos"></div>
            <button id="reset-map-view" class="map-reset-control" type="button" title="Restablecer extensión del mapa" aria-label="Restablecer extensión y nivel de zoom del mapa">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 3H3v5M16 3h5v5M21 16v5h-5M8 21H3v-5" />
                </svg>
            </button>
            <div class="map-layer-switcher">
                <button id="toggle-map-layers" type="button" aria-expanded="false" aria-controls="map-layer-panel">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/></svg>
                    <span>Capas</span><small id="base-layer-name">Cartográfico</small>
                </button>
                <div id="map-layer-panel" class="map-layer-panel" hidden>
                    <strong>Mapa base</strong>
                    <label><input id="basemap-street" type="radio" name="map-basemap" value="street" checked><span class="layer-swatch street"></span><span>Cartográfico<small>Calles y localidades</small></span></label>
                    <label><input id="basemap-terrain" type="radio" name="map-basemap" value="terrain"><span class="layer-swatch terrain"></span><span>Relieve<small>Topografía y elevación</small></span></label>
                    <label><input id="basemap-satellite" type="radio" name="map-basemap" value="satellite"><span class="layer-swatch satellite"></span><span>Satélite<small>Imagen mundial</small></span></label>
                    <div class="weather-layer-section">
                        <strong>Meteorología</strong>
                        <label class="weather-layer-option" title="Imagen GeoColor del satélite GOES-East distribuida por NASA GIBS">
                            <input id="weather-clouds" type="checkbox">
                            <span class="weather-swatch clouds" aria-hidden="true"></span>
                            <span>Nubes GOES<small>NASA · latencia aprox. 40 min</small></span>
                        </label>
                        <label class="weather-layer-option" title="Reflectividad compuesta del último cuadro disponible en RainViewer">
                            <input id="weather-radar" type="checkbox">
                            <span class="weather-swatch radar" aria-hidden="true"></span>
                            <span>Radar de lluvia<small>Último cuadro · cada 5 min</small></span>
                        </label>
                        <label class="weather-opacity-control" for="weather-opacity">
                            <span>Opacidad</span>
                            <input id="weather-opacity" type="range" min="20" max="90" step="5" value="60">
                            <output id="weather-opacity-value" for="weather-opacity">60%</output>
                        </label>
                        <p id="weather-layer-status" role="status" aria-live="polite">Activa una capa para consultar la imagen reciente.</p>
                        <small class="weather-layer-sources"><a href="https://www.earthdata.nasa.gov/data/tools/worldview" target="_blank" rel="noopener noreferrer">NASA GIBS</a> · <a href="https://www.rainviewer.com/" target="_blank" rel="noopener noreferrer">RainViewer</a></small>
                    </div>
                </div>
            </div>
            <div id="map-layer-transition" class="map-layer-transition" aria-hidden="true"></div>
            <fieldset class="hazard-layer-control" aria-label="Capas de fenómenos naturales">
                <legend>Fenómenos</legend>
                <label title="Ciclones tropicales activos · fuente NHC/NOAA">
                    <input id="layer-cyclones" type="checkbox" checked>
                    <span class="hazard-symbol cyclone" aria-hidden="true">↻</span>
                    Ciclones <b id="count-cyclones">…</b>
                </label>
                <label title="Sismos M3.5+ de los últimos 7 días · fuente USGS">
                    <input id="layer-earthquakes" type="checkbox" checked>
                    <span class="hazard-symbol earthquake" aria-hidden="true"></span>
                    Sismos <b id="count-earthquakes">…</b>
                </label>
                <small id="hazard-status" role="status" aria-live="polite">Actualizando fuentes oficiales…</small>
            </fieldset>
            <button id="open-query-dialog" class="query-map-launcher" type="button">
                <span aria-hidden="true">⌕</span> Consultar estación
            </button>
            <button id="open-cuenca-launcher" class="query-map-launcher cuenca-map-launcher" type="button" title="Abrir análisis de lluvia por cuenca o grupo">
                <span aria-hidden="true">🌧️</span> Lluvia por cuenca
            </button>
        </div>

        <div class="map-statusbar">
            <span id="map-status" role="status" aria-live="polite" data-state="loading">Conectando con DB_ATLAS…</span>
            <span id="signal-status" role="status">Calculando semáforo de TX…</span>
        </div>
    </section>

    <dialog id="query-dialog" class="query-dialog" aria-labelledby="query-dialog-title">
      <div class="query-dialog-shell">
        <header class="query-dialog-header">
            <div>
                <span>Datos hidrometeorológicos</span>
                <h2 id="query-dialog-title">Consulta y series temporales</h2>
            </div>
            <button id="close-query-dialog" type="button" aria-label="Cerrar consulta">×</button>
        </header>
        <div class="query-dialog-body">
    <!-- SECCIÓN 2: FORMULARIO DE CONSULTA & PARÁMETROS -->
    <section class="cyber-card query-parameters-card">
        <form id="query-form">
            <div class="cyber-form-grid">
                <div class="cyber-field">
                    <label>Estación / Clave DCP</label>
                    <select id="query-station" class="cyber-select" required>
                        <option value="">Cargando catálogo de estaciones...</option>
                    </select>
                </div>
                <div class="cyber-field">
                    <label>Producto Hidrológico</label>
                    <select id="query-product" class="cyber-select" autocomplete="off">
                        @foreach (var p in QueryProduct.All.Where(x => !x.Title.StartsWith("GOES", StringComparison.OrdinalIgnoreCase)))
                        {
                            if (p.Key == "variables")
                            {
                                <option value="@p.Key" selected>@p.Title</option>
                            }
                            else
                            {
                                <option value="@p.Key">@p.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="cyber-field">
                    <label>Rango de Tiempo</label>
                    <select id="query-period" class="cyber-select">
                        <option value="last7" selected>Últimos 7 días (Automático)</option>
                        <option value="custom">Rango Personalizado (UTC)</option>
                    </select>
                </div>
                <div class="cyber-field custom-date-field">
                    <label>Desde (UTC)</label>
                    <input id="query-start" class="cyber-input" type="datetime-local" step="60" required/>
                </div>
                <div class="cyber-field custom-date-field">
                    <label>Hasta (UTC)</label>
                    <input id="query-end" class="cyber-input" type="datetime-local" step="60" required/>
                </div>
                <div class="query-actions">
                    <button id="query-submit" class="btn-cyber-primary" type="submit">
                        <span aria-hidden="true">⌕</span> Consultar
                    </button>
                    <button id="toggle-goes-view" class="btn-cyber-goes" type="button" aria-pressed="false">
                        📡 TX / Telemetría GOES
                    </button>
                    <button id="query-export" class="btn-cyber-secondary" type="button" disabled>
                        Descargar CSV
                    </button>
                </div>
            </div>
        </form>
        <div class="query-feedback">
            <p id="query-status" role="status" aria-live="polite"></p>
            <details id="query-note" hidden><summary>Notas de los datos</summary><p id="query-note-text"></p></details>
        </div>
    </section>

    <!-- ESTADO DE CARGA PROFESIONAL DE TELEMETRÍA Y OBSERVACIONES -->
    <div id="query-loading" class="query-loading-panel" hidden>
        <div class="query-loading-card">
            <div class="query-loading-top">
                <div class="query-loading-radar-orbit" aria-hidden="true">
                    <div class="radar-ping"></div>
                    <div class="radar-core">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/>
                            <path d="M12 6a6 6 0 1 0 6 6 6 6 0 0 0-6-6zm0 8a2 2 0 1 1 2-2 2 2 0 0 1-2 2z"/>
                        </svg>
                    </div>
                </div>
                <div class="query-loading-text">
                    <h3 class="query-loading-title">Cargando datos hidrometeorológicos…</h3>
                    <p class="query-loading-sub">Sincronizando series de tiempo, sensores y telemetría satelital</p>
                </div>
            </div>

            <!-- SKELETON PREVIEW PARA LA GRÁFICA Y KPIs -->
            <div class="query-skeleton-container" aria-hidden="true">
                <div class="skeleton-toolbar">
                    <div class="skeleton-shimmer skeleton-pill w-120"></div>
                    <div class="skeleton-shimmer skeleton-pill w-80"></div>
                </div>
                <div class="skeleton-chart-box">
                    <div class="skeleton-chart-lines">
                        <div class="chart-wave wave-1"></div>
                        <div class="chart-wave wave-2"></div>
                    </div>
                </div>
                <div class="skeleton-kpis">
                    <div class="skeleton-shimmer skeleton-kpi-item"></div>
                    <div class="skeleton-shimmer skeleton-kpi-item"></div>
                    <div class="skeleton-shimmer skeleton-kpi-item"></div>
                    <div class="skeleton-shimmer skeleton-kpi-item"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN 3: RESULTADOS, HIDROGRAMA Y TABLA -->
    <div id="query-results" hidden>
        <section id="chart-workspace-card" class="cyber-card chart-workspace">
            <div class="chart-toolbar">
                <div>
                    <span class="chart-eyebrow">Análisis temporal</span>
                    <h3>Series de la estación</h3>
                </div>
                <div class="chart-controls">
                    <div class="chart-mode" aria-label="Modo de gráfica">
                        <button id="chart-mode-single" type="button" aria-pressed="true">Individual</button>
                        <button id="chart-mode-combine" type="button" aria-pressed="false">Combinar</button>
                    </div>
                    <label>Métrica
                        <select id="chart-metric" class="cyber-select"></select>
                    </label>
                </div>
            </div>
            <div id="chart-series-strip" class="chart-series-strip" role="group" aria-label="Series disponibles"></div>
            <div id="chart-legend" class="chart-legend" aria-live="polite"></div>
            <div class="chart-canvas">
                <div id="series-chart" role="region" aria-label="Gráfica temporal interactiva de telemetría"></div>
            </div>
            <div class="chart-bottom-bar">
                <div class="kpi-compact"><span>Lecturas</span><b id="kpi-total-obs">—</b></div>
                <div class="kpi-compact"><span>Mínimo</span><b id="kpi-min-val">—</b></div>
                <div class="kpi-compact"><span>Promedio</span><b id="kpi-avg-val">—</b></div>
                <div class="kpi-compact"><span>Máximo</span><b id="kpi-max-val">—</b></div>
                <div class="kpi-compact"><span>Suma</span><b id="kpi-sum-val">—</b></div>
                <p id="chart-summary"></p>
            </div>
        </section>

        <section id="goes-messages-panel" class="cyber-card goes-messages-panel" hidden>
            <div class="goes-messages-header">
                <div>
                    <span class="chart-eyebrow">Telemetría Satelital DOMSAT / LRGS · Control de Recepción</span>
                    <h3>Transmisiones GOES: Esperadas vs. Recibidas y Tramas Crudas</h3>
                </div>
                <div class="goes-submode" role="group" aria-label="Vista de telemetría GOES">
                    <button id="goes-tab-transmisiones" type="button" aria-pressed="true" data-goes-product="transmisiones">Tramas y Ventanas</button>
                    <button id="goes-tab-eficiencia" type="button" aria-pressed="false" data-goes-product="eficiencia">Eficiencia Diaria</button>
                    <button id="goes-tab-recepcion" type="button" aria-pressed="false" data-goes-product="recepcion">Intentos LRGS</button>
                </div>
            </div>
            <div id="goes-messages-summary" class="goes-messages-summary"></div>
            <div id="goes-daily-strip" class="goes-daily-strip" aria-label="Cumplimiento diario Esperadas vs Recibidas"></div>
            <div id="goes-messages-list" class="goes-messages-list" role="region" aria-label="Bitácora de ventanas esperadas vs recibidas y tramas GOES crudas"></div>
        </section>

        <details class="cyber-card result-table-panel">
            <summary><span>Registro detallado</span><small>Mostrar las filas consultadas</small></summary>
            <div id="result-table"></div>
        </details>
    </div>
        </div>
      </div>
    </dialog>

    <!-- MODAL 2: ANALÍTICA DE LLUVIA POR CUENCA / GRUPO -->
    <dialog id="cuenca-dialog" class="query-dialog cuenca-dialog" aria-labelledby="cuenca-dialog-title">
      <div class="query-dialog-shell">
        <header class="query-dialog-header">
            <div>
                <span>Monitoreo Hidrometeorológico por Cuenca</span>
                <h2 id="cuenca-dialog-title">🌧️ Lluvia Horaria y Promedio de Cuenca</h2>
            </div>
            <button id="close-cuenca-dialog" type="button" aria-label="Cerrar modal de cuenca">×</button>
        </header>
        <div class="query-dialog-body cuenca-dialog-body">
            <!-- Barra de control de cuenca -->
            <section class="cyber-card cuenca-params-card">
                <div class="cuenca-toolbar-grid">
                    <div class="cyber-field">
                        <label for="cuenca-dialog-select">Cuenca o Grupo</label>
                        <select id="cuenca-dialog-select" class="cyber-select">
                            <option value="">Selecciona una cuenca...</option>
                        </select>
                    </div>
                    <div class="cyber-field">
                        <label for="cuenca-horas-select">Ventana de tiempo</label>
                        <select id="cuenca-horas-select" class="cyber-select">
                            <option value="12">Últimas 12 horas</option>
                            <option value="24" selected>Últimas 24 horas</option>
                            <option value="48">Últimas 48 horas</option>
                            <option value="72">Últimas 72 horas</option>
                            <option value="168">Últimos 7 días</option>
                        </select>
                    </div>
                    <div class="cuenca-actions">
                        <button id="btn-cuenca-consultar" class="btn-cyber-primary" type="button">
                            <span aria-hidden="true">⌕</span> Actualizar análisis
                        </button>
                        <button id="btn-cuenca-abrir-creador" class="btn-cyber-gold" type="button">
                            ✨ ¡Armar mi cuenca o grupo!
                        </button>
                    </div>
                </div>
            </section>

            <!-- KPIs de la Cuenca -->
            <div class="cuenca-kpi-grid">
                <div class="kpi-card-cyber">
                    <span>Lluvia Promedio Acumulada</span>
                    <strong id="kpi-cuenca-promedio-val">— mm</strong>
                    <small>Promedio total de la cuenca</small>
                </div>
                <div class="kpi-card-cyber">
                    <span>Pico Máximo Horario</span>
                    <strong id="kpi-cuenca-maximo-val">— mm/h</strong>
                    <small id="kpi-cuenca-maximo-sub">—</small>
                </div>
                <div class="kpi-card-cyber">
                    <span>Estaciones con Lluvia</span>
                    <strong id="kpi-cuenca-estaciones-val">—</strong>
                    <small id="kpi-cuenca-estaciones-sub">de 0 estaciones evaluadas</small>
                </div>
                <div class="kpi-card-cyber">
                    <span>Zona Horaria / Referencia</span>
                    <strong id="kpi-cuenca-tz-val">UTC-06:00</strong>
                    <small id="kpi-cuenca-horas-sub">Últimas 24 horas continuas</small>
                </div>
            </div>

            <!-- Gráfica de Cuenca: Promedio vs Máximo -->
            <section class="cyber-card cuenca-chart-card">
                <div class="chart-toolbar">
                    <div>
                        <span class="chart-eyebrow">Hietograma Colectivo</span>
                        <h3 id="cuenca-chart-heading">Distribución Horaria de Precipitación</h3>
                    </div>
                    <div class="cuenca-chart-legend">
                        <span><i style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#0284c7;vertical-align:middle;margin-right:4px;"></i> Promedio Cuenca (mm)</span>
                        <span><i style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#f59e0b;vertical-align:middle;margin-right:4px;"></i> Máximo Horario (mm)</span>
                    </div>
                </div>
                <div class="chart-canvas" style="height:300px;">
                    <div id="cuenca-series-chart" style="width:100%;height:100%;"></div>
                </div>
            </section>

            <!-- Desglose de Estaciones -->
            <section class="cyber-card cuenca-stations-card">
                <div class="chart-toolbar">
                    <div>
                        <span class="chart-eyebrow">Detalle Estación por Estación</span>
                        <h3>Acumulados y Estado de la Red</h3>
                    </div>
                    <div class="cyber-field" style="max-width:240px;">
                        <input id="cuenca-stations-filter" class="cyber-input" type="text" placeholder="Filtrar estaciones..." style="height:30px;font-size:0.75rem;" />
                    </div>
                </div>
                <div class="cuenca-table-scroll">
                    <table class="cuenca-table" id="cuenca-stations-table">
                        <thead>
                            <tr>
                                <th>Clave / DCP</th>
                                <th>Estación</th>
                                <th>Lluvia Acumulada</th>
                                <th>Nivel Relativo</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody id="cuenca-stations-tbody">
                            <tr><td colspan="5" style="text-align:center;padding:20px;color:#70868f;">Cargando estaciones de la cuenca...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
      </div>
    </dialog>

    <!-- MODAL 3: ¡ARMAR MI CUENCA O GRUPO! (FREEMIUM / SAAS) -->
    <dialog id="grupo-modal-dialog" class="query-dialog grupo-modal-dialog" aria-labelledby="grupo-modal-title">
      <div class="query-dialog-shell">
        <header class="query-dialog-header">
            <div>
                <span>Personalización de Red Hidrológica</span>
                <h2 id="grupo-modal-title">✨ ¡Armar mi cuenca o grupo de estaciones!</h2>
            </div>
            <button id="close-grupo-dialog" type="button" aria-label="Cerrar creador de grupo">×</button>
        </header>
        <div class="query-dialog-body grupo-dialog-body">
            <!-- Freemium Banner -->
            <div class="saas-banner">
                <div class="saas-banner-icon">🌧️✨</div>
                <div class="saas-banner-content">
                    <div class="saas-badge">MODALIDAD GRATUITA · HASTA 3 GRUPOS</div>
                    <h3>Arma grupos a tu medida y obtén lluvia horaria promedio en tiempo real</h3>
                    <p>Crea grupos para monitorear presas en cascada, municipios o subcuencas de tu interés. Con tu cuenta gratuita puedes registrar y guardar <strong>hasta 3 grupos</strong>. ¿Necesitas más de 3 grupos o alertas de lluvia por correo/WhatsApp? Suscríbete a la modalidad Pro por solo <strong>$100 MXN / mes</strong>.</p>
                </div>
            </div>

            <!-- Constructor de grupo -->
            <div class="grupo-builder-grid">
                <!-- Columna Izquierda: Parámetros del Grupo -->
                <div class="cyber-card grupo-form-card">
